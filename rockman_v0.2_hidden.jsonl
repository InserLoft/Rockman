{"task_id": "Rockman/DEBU_0139", "category": "Debugging", "subcategory": "Edge Cases", "difficulty": 3, "prompt": "# Buggy code - fix the edge case handling\ndef max_subarray_sum_Rockman_DEBU_0139(nums: list[int]) -> int:\n    \"\"\"\n    Kadane's algorithm - maximum subarray sum.\n    \"\"\"\n    max_sum = nums[0]\n    current_sum = nums[0]\n    for num in nums[1:]:\n        current_sum = max(num, current_sum + num)\n        max_sum = max(max_sum, current_sum)\n    return max_sum\n", "public_test": "assert max_subarray_sum_Rockman_DEBU_0139([-2,1,-3,4,-1,2,1,-5,4]) == 6\nassert max_subarray_sum_Rockman_DEBU_0139([1]) == 1\nassert max_subarray_sum_Rockman_DEBU_0139([5,4,-1,7,8]) == 23\n", "time_limit": 2.0, "memory_limit": 256, "language": "python", "tags": ["debugging", "edge-case", "kadane", "empty-input"], "source_type": "generated", "expected_complexity": "O(n)", "deterministic": true, "task_type": "debugging", "version": "v0.2", "metadata": {"generator": "TaskGenerator", "template_category": "Debugging", "template_subcategory": "Edge Cases", "parameters": {"difficulty": 3}}, "creation_date": "2026-09-20T07:13:50.816903Z", "publication_date": null, "source_url": null, "source_license": null, "derived_from": [], "generation_method": null, "generator_version": null, "content_hash": "5af983045449e6f1", "canary": "ROCKMAN_CANARY_18503dc36d59fb28", "hidden_test_encrypted": "5GAqbF7kkp9jT162tqF9WDQZeTfRu20BmUFdSBZflOsKe8/JnKMePNz6PISSKINktriMvstiowSzYpNRcixURIo6XvcY1HWBX78pANDcZlpGIWjpKz5YTNsbwKrYnR4HCEFfz3+v12n8aKChdIerchAY6RQRJg3ja/I90e23HGwcPwZtXaQfz6ynBgqJrUMgnkpS6JkOOqceVRpVcwReLMHvb9IfMYhnPWA=", "hidden_test_nonce": "VAyUob0AxsVszcU4", "hidden_test_tag": "cLHmB1fteOf37HoLcfV0Zg=="}
{"task_id": "Rockman/DEBU_0152", "category": "Debugging", "subcategory": "Edge Cases", "difficulty": 3, "prompt": "# Buggy code - fix the edge case handling\ndef max_subarray_sum_Rockman_DEBU_0152(nums: list[int]) -> int:\n    \"\"\"\n    Kadane's algorithm - maximum subarray sum.\n    \"\"\"\n    max_sum = nums[0]\n    current_sum = nums[0]\n    for num in nums[1:]:\n        current_sum = max(num, current_sum + num)\n        max_sum = max(max_sum, current_sum)\n    return max_sum\n", "public_test": "assert max_subarray_sum_Rockman_DEBU_0152([-2,1,-3,4,-1,2,1,-5,4]) == 6\nassert max_subarray_sum_Rockman_DEBU_0152([1]) == 1\nassert max_subarray_sum_Rockman_DEBU_0152([5,4,-1,7,8]) == 23\n", "time_limit": 2.0, "memory_limit": 256, "language": "python", "tags": ["debugging", "edge-case", "kadane", "empty-input"], "source_type": "generated", "expected_complexity": "O(n)", "deterministic": true, "task_type": "debugging", "version": "v0.2", "metadata": {"generator": "TaskGenerator", "template_category": "Debugging", "template_subcategory": "Edge Cases", "parameters": {"difficulty": 3}}, "creation_date": "2026-09-20T07:13:50.818269Z", "publication_date": null, "source_url": null, "source_license": null, "derived_from": [], "generation_method": null, "generator_version": null, "content_hash": "cf31c6292e75bc2b", "canary": "ROCKMAN_CANARY_f77f9142abe942c3", "hidden_test_encrypted": "waG6Ze9WSKtXhs7bALVbG+NutVWqp813CLnJ1outXfDms4+/ZHk1CpYwm6cWQBX8C8e5n0ILzndGqUPOLtNVu4lyWq91tPd6UL0TOgAu7v8ajoxg2St3J8SrfmZffPHxGUfPuk/qlXeCNEYS0peXKcEYs7TSAtdQTYOhDsFduDePAA+RdM2YLmzl/1IXDYBBQQC1SKAu55up6Vo1QJ/tE6UeMNKXVuQGG30=", "hidden_test_nonce": "ndAcHhpItKxKeJ+i", "hidden_test_tag": "4Q45SDvJLvSYdDYgHMdaEw=="}
{"task_id": "Rockman/COMP_0180", "category": "Complexity", "subcategory": "O(n log n)", "difficulty": 4, "prompt": "def count_inversions_Rockman_COMP_0180(arr: list[int]) -> int:\n    \"\"\"\n    Count inversions in array using O(n log n) algorithm.\n    An inversion is a pair (i, j) where i < j and arr[i] > arr[j].\n    \"\"\"\n", "public_test": "assert count_inversions_Rockman_COMP_0180([2, 4, 1, 3, 5]) == 3\nassert count_inversions_Rockman_COMP_0180([5, 4, 3, 2, 1]) == 10\nassert count_inversions_Rockman_COMP_0180([1, 2, 3, 4, 5]) == 0\n", "time_limit": 2.0, "memory_limit": 256, "language": "python", "tags": ["complexity", "divide-conquer", "inversions", "merge-sort"], "source_type": "generated", "expected_complexity": "O(n log n)", "deterministic": true, "task_type": "optimization", "version": "v0.2", "metadata": {"generator": "TaskGenerator", "template_category": "Complexity", "template_subcategory": "O(n log n)", "parameters": {"difficulty": 4}}, "creation_date": "2026-09-20T07:13:50.821438Z", "publication_date": null, "source_url": null, "source_license": null, "derived_from": [], "generation_method": null, "generator_version": null, "content_hash": "b303fca6b66b3b46", "canary": "ROCKMAN_CANARY_35c99fe72c892cba", "hidden_test_encrypted": "", "hidden_test_nonce": "+gaXHij8O8+pibP3", "hidden_test_tag": "VbNqHQyYBVpYCRbmAVD9Rg=="}

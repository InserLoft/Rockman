{"task_id": "Rockman/GRAP_0058", "category": "Graphs", "subcategory": "Shortest Path", "difficulty": 4, "prompt": "def dijkstra_Rockman_GRAP_0058(n: int, edges: list[tuple[int, int, int]], start: int) -> list[int]:\n    \"\"\"\n    Dijkstra's algorithm for single-source shortest paths.\n    n: number of vertices (0-indexed)\n    edges: list of (u, v, weight) for directed edges\n    start: source vertex\n    Returns list of distances, use -1 for unreachable.\n    \"\"\"\n", "public_test": "n = 5\nedges = [(0,1,10), (0,2,3), (1,2,1), (1,3,2), (2,1,4), (2,3,8), (2,4,2), (3,4,7), (4,3,9)]\nassert dijkstra_Rockman_GRAP_0058(n, edges, 0) == [0, 7, 3, 9, 5]\n\nn = 4\nedges = [(0,1,1), (1,2,1), (2,3,1)]\nassert dijkstra_Rockman_GRAP_0058(n, edges, 0) == [0, 1, 2, 3]\n", "time_limit": 2.0, "memory_limit": 256, "language": "python", "tags": ["graph", "shortest-path", "dijkstra", "priority-queue"], "source_type": "generated", "expected_complexity": "O((V+E) log V)", "deterministic": true, "task_type": "generation", "version": "v0.2", "metadata": {"generator": "TaskGenerator", "template_category": "Graphs", "template_subcategory": "Shortest Path", "parameters": {"difficulty": 4}}, "creation_date": "2026-09-20T07:13:50.798553Z", "publication_date": null, "source_url": null, "source_license": null, "derived_from": [], "generation_method": null, "generator_version": null, "content_hash": "40ca41575f99c507", "canary": "ROCKMAN_CANARY_a0613d2c333f5cf2", "hidden_test_encrypted": "", "hidden_test_nonce": "DkZT+Hvd4quA/0na", "hidden_test_tag": "uknn5YEGyBERKoWw0o8ArQ=="}

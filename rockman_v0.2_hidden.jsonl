{"task_id": "Rockman/DEBU_0115", "category": "Debugging", "subcategory": "Off-by-One", "difficulty": 3, "prompt": "# Buggy code - fix the off-by-one error\ndef binary_search_Rockman_DEBU_0115(arr: list[int], target: int) -> int:\n    \"\"\"\n    Binary search for target in sorted array arr.\n    Returns index if found, -1 otherwise.\n    \"\"\"\n    left, right = 0, len(arr)\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            return mid\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1\n", "public_test": "assert binary_search_Rockman_DEBU_0115([1,2,3,4,5], 3) == 2\nassert binary_search_Rockman_DEBU_0115([1,2,3,4,5], 6) == -1\nassert binary_search_Rockman_DEBU_0115([1], 1) == 0\nassert binary_search_Rockman_DEBU_0115([], 1) == -1\n", "time_limit": 2.0, "memory_limit": 256, "language": "python", "tags": ["debugging", "off-by-one", "binary-search", "logic-bug"], "source_type": "generated", "expected_complexity": "O(log n)", "deterministic": true, "task_type": "debugging", "version": "v0.2", "metadata": {"generator": "TaskGenerator", "template_category": "Debugging", "template_subcategory": "Off-by-One", "parameters": {"difficulty": 3}}, "creation_date": "2026-09-20T07:13:50.811872Z", "publication_date": null, "source_url": null, "source_license": null, "derived_from": [], "generation_method": null, "generator_version": null, "content_hash": "32200b38e56a7bcb", "canary": "ROCKMAN_CANARY_38a5b1ebaf6d0a58", "hidden_test_encrypted": "", "hidden_test_nonce": "yoU/0zZVGG6K5JJf", "hidden_test_tag": "QZHD3Ez5DBzcyw7+u718Bw=="}
